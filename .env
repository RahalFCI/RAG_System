# some values needed to be updated 

APP_NAME="RAG_System"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB

POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="root"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="Rag"

# ========================= LLM Config =========================
GENERATION_BACKEND = "OPENAI"
EMBEDDING_BACKEND = "OPENAI"

OPENAI_API_KEY="sk-"
OPENAI_API_URL=""
COHERE_API_KEY="m8-"

GENERATION_MODEL_ID_LITERAL = []
GENERATION_MODEL_ID="llama3:8b"
EMBEDDING_MODEL_ID="qwen3-embedding:4b"
EMBEDDING_MODEL_SIZE=2560

INPUT_DAFAULT_MAX_CHARACTERS=8192
GENERATION_DAFAULT_MAX_TOKENS=2048
GENERATION_DAFAULT_TEMPERATURE=0.7

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND_LITERAL = ["PGVECTOR"]
VECTOR_DB_BACKEND = "PGVECTOR"
VECTOR_DB_PATH = "postgresql://postgres:root@localhost:5432/Rag"
VECTOR_DB_DISTANCE_METHOD = "cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD = 1000
GOOGLE_MAPS_API_KEY=""
# ========================= Template Configs =========================
PRIMARY_LANG = "ar"
DEFAULT_LANG = "ar"
